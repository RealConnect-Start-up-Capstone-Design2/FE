    "@tanstack/react-virtual": "^3.11.2",
    "axios": "1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
